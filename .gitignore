# OS / 编辑器
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# 依赖与缓存
node_modules/
__pycache__/
*.pyc

# 工具目录：只入库构建脚本与回归脚本；探针、抓包素材、截图产物一律忽略
_dev-tools/*
!_dev-tools/*.py
!_dev-tools/probe-navflash.js
!_dev-tools/probe-navmove.js
!_dev-tools/probe-hosted.js
!_dev-tools/verify-*.js

# preview 中间文件（*-v7.html 正本入库）
preview/_src/
preview/shot-*.png
preview/crop-*.png
preview/ref-*.png

# 本地推送凭据（含 token，绝不能提交）
.git-credentials-local
